# Docker 部署配置（复制为 .env）
POSTGRES_USER=artex
POSTGRES_PASSWORD=
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Optional exact browser origins, comma-separated, for a separate frontend.
ARTEX_ALLOWED_ORIGINS=
